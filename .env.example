# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Random secret used to sign admin session cookies.
# Generate one with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Used by scripts/create-admin.mjs to create the first admin login.
ADMIN_SEED_EMAIL=you@degsslimited.com
ADMIN_SEED_PASSWORD=change-me
ADMIN_SEED_NAME="Site Admin"

# Cloudinary (Dashboard -> API Keys). Used to store property/team photos
# uploaded through the admin dashboard. Either set CLOUDINARY_URL alone,
# or set the three CLOUDINARY_CLOUD_NAME / API_KEY / API_SECRET vars.
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name

# Cloudflare Turnstile (dash.cloudflare.com -> Turnstile). Spam-protects the
# public /contact form. The contact form skips the CAPTCHA entirely until
# both vars are set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
